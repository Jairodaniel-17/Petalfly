{
  "label": "Mi Tema Personalizado",
  "description": "Duplica este archivo, renombralo a my-theme.json y ajusta los tokens.",
  "variables": {
    "--color-bg": "#0f0f0f",
    "--color-bg-soft": "#121212",
    "--color-surface": "#151515",
    "--color-surface-alt": "#1b1b1b",
    "--color-surface-raised": "#202020",
    "--color-border": "#2a2a2a",
    "--color-border-strong": "#3a3a3a",
    "--color-text": "#f4f4f4",
    "--color-text-muted": "#8f8f8f",
    "--color-heading": "#ffffff",
    "--color-accent": "#f5a623",
    "--color-accent-soft": "#f76b1c",
    "--color-accent-strong": "#ff4f81",
    "--color-accent-muted": "#8a6df5",
    "--color-success": "#6dd5b9",
    "--color-warning": "#f5e05b",
    "--color-danger": "#ff4f81",
    "--color-info": "#7ad3f7",
    "--color-overlay": "rgba(0, 0, 0, 0.75)",
    "--input-bg": "rgba(20, 20, 20, 0.9)",
    "--input-border": "#343434",
    "--input-text": "#f4f4f4",
    "--input-placeholder": "rgba(244, 244, 244, 0.4)",
    "--sidebar-bg": "#121212",
    "--sidebar-border": "rgba(255, 255, 255, 0.05)",
    "--sidebar-text": "#f4f4f4",
    "--sidebar-active-bg": "rgba(255, 255, 255, 0.08)",
    "--sidebar-active-text": "#f76b1c",
    "--panel-bg": "#181818",
    "--panel-border": "#2a2a2a",
    "--panel-text": "#f4f4f4",
    "--panel-header-bg": "rgba(18, 18, 18, 0.95)",
    "--card-bg": "rgba(255, 255, 255, 0.03)",
    "--card-border": "#2a2a2a",
    "--card-text": "#f4f4f4",
    "--shadow-soft": "0 20px 45px rgba(0, 0, 0, 0.55)",
    "--shadow-strong": "0 35px 90px rgba(0, 0, 0, 0.7)",
    "--radius-sm": "6px",
    "--radius-md": "10px",
    "--radius-lg": "16px",
    "--font-mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  }
}
